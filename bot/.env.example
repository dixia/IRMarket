# IRMarket Bot — Environment Configuration

# Private key of the verifier wallet (must hold MON + approved tokens)
PRIVATE_KEY=0x_your_private_key_here

# Monad WebSocket RPC (testnet) — for sending txs
RPC_WS_URL=wss://testnet-rpc.monad.xyz/ws

# Monad HTTP RPC (testnet) — for polling event logs
RPC_HTTP_URL=https://rpc-testnet.monadinfra.com

# IRMarket contract address
MARKET_ADDRESS=0x...

# Monoracle settlement contract (live on Monad testnet)
ORACLE_ADDRESS=0x1ABABc60Ca6950C94eA80F2f611AB06aAAAD28c0

# Multicall3 (n3) used to batch the bot's per-step reads into one eth_call.
# Canonical Monad testnet deployment; override only for a chain without n3
# (the bot then falls back to one eth_call per read).
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# ---------- Monitored Pairs & Fair Prices ----------
# Single-pair fallback (used only when ASSETS_FILE has no usable assets).
# Format: BASE_TOKEN,QUOTE_TOKEN,FAIR_PRICE
# Fair price is 1e18 fixed-point
MONITORED_PAIRS=0xAf078b1cAb4797bA018C8354913eaE22f0f1F719,0x3c34C844EeaeCbc760a74723FC67d8DF49a05093,130000000000000000000

# Optional display symbol for the single-pair fallback (defaults to base token prefix)
# ASSET_SYMBOL=NVDA

# ---------- Multi-Asset (optional) ----------
# Path to a deployment-assets.json written by the deploy script. Relative paths
# resolve against the repo root; defaults to deployment-assets.json there.
# When the file exists and lists at least one asset, the bot runs ONE PAIR PER
# ASSET and MONITORED_PAIRS/MARKET_ID below are ignored. Schema:
#   {
#     "network": "monad-testnet", "chainId": 10143,
#     "oracle": "0x...", "market": "0x...", "quoteToken": "0x...",
#     "assets": [
#       { "symbol": "NVDA", "baseToken": "0x...", "quoteToken": "0x...",
#         "fairPrice": "130000000000000000000", "marketId": "2", "expiryBlock": "12345" }
#     ]
#   }
# `oracle`/`market`/`quoteToken` are shared; each asset supplies its own
# `baseToken`, `fairPrice` (1e18 string) and `marketId`.
# ASSETS_FILE=deployment-assets.json

# Registry symbols this bot must NOT quote, comma-separated (case-insensitive).
# Lets you stop quoting a market without touching the on-chain market or the
# registry. NVDA is retired from the demo set in favour of MOUTAI (600519.SH).
BOT_SKIP_SYMBOLS=NVDA

# ---------- Market Round ----------
# The IRMarket marketId the bot quotes for (createMarket result)
MARKET_ID=0
# Next-round length in blocks (6000 ≈ 30 min @300ms blocks)
ROUND_BLOCKS=6000
# After expiry, bot creates the next round's market as marketMaker
AUTO_CREATE_MARKET=1
# Wrapper fee basis points for rounds the bot creates (1% = 100)
FEE_BPS=100

# ---------- Veto Threshold ----------
# Minimum deviation in basis points (1 bp = 0.01%) to trigger a veto
THRESHOLD_BPS=100

# ---------- Startup Catch-Up ----------
CATCH_UP_BLOCKS=10

# ---------- Gas Configuration ----------
# Monad charges by gas LIMIT, not gasUsed, so these limits ARE the cost of every
# send. The defaults in bot/verifier.py are measured (see the GAS_DEFAULTS table
# there); override one only to bump it, never to guess. Re-measure with
# `npx hardhat run script/gas-report.js` before changing the defaults.
# GAS_APPROVE_WEI=60000
# GAS_SUBMIT_QUOTE_WEI=360000
# GAS_SETTLE_WEI=80000
# GAS_WITHDRAW_WEI=150000
# GAS_CREATE_MARKET_WEI=240000
#
# Optional ceiling on gasPrice (wei). The bot otherwise uses eth_gas_price.
# GAS_PRICE_CAP_WEI=200000000000

# ---------- Quoting Loop (D-05) ----------
# Loop cadence (seconds). Quotes are restocked on veto; this is the poll rate.
QUOTE_INTERVAL_SECONDS=5
# Quote collateral size (base units, 1e18 decimals)
QUOTE_BASE_AMOUNT=1000000000000000000

# ---------- Expiry Settlement Quote (D-06) ----------
# Lead blocks before expiry at which the final settlement quote is submitted
# (it settles LAST and becomes the round mark).
#
# The budget rule: a quote succeeds only if it is included strictly BEFORE its
# own expiry. A signed tx lands 1-N blocks after the bot's decision block, and
# the mark-quote branch only wins while
#     lead_blocks > (worst-case delivery latency in blocks).
# At ~330 ms/block, a lead of 2 left a 0.6 s window against ~1 s of delivery
# latency, so the mark quote was rejected with `ExpiryMustBeFuture` most rounds
# and each revert still paid its full 400k gas limit.
#
# The stage run measured the delivery latency at 3, 7 AND 28 blocks (~9.3 s) on
# the same shape of tx, so the lead has to cover the observed distribution, not
# just the median — hence 30 blocks (~10 s). Tracked as dixia/IRMarket#22, with
# the probes an agent should run: the latency histogram, a paid-vs-public RPC
# comparison, and a >=3-round verification that the mark lands at 30.
SETTLEMENT_QUOTE_LEAD_BLOCKS=30

# ---------- Real Price Feed (docs/design/bot-real-price-feed-spec.md §6.2) ----------
# Master switch: 0 = current synthetic random-walk demo behaviour; 1 = real feeds
# (per-asset `priceSource` in deployment-assets.json selects the adapter).
PRICE_FEED_ENABLED=0
# Per-asset cache TTL (seconds) — one fetch/min/asset; never fetch in the quote loop.
PRICE_FEED_TTL_SECONDS=60
# Beyond this age with all sources down -> outage policy applies (below).
PRICE_FEED_MAX_STALENESS_SECONDS=3600
# Outage policy when NO usable price exists (never fetched, or beyond staleness):
#   halt = default; the bot refuses to quote (raises FeedOutageError) — a stale
#          `fairPrice` seed can be 15x off reality and is instantly veto-arbitraged.
#   seed = legacy: fall back to the registry `fairPrice` with an ERROR log.
#          ONLY use after refreshing fairPrice values in deployment-assets.json.
PRICE_FEED_OUTAGE_POLICY=halt
# Quote-per-USD factor applied to US real prices (nasdaq/yahoo) before WAD conversion
# (1.0 = nominal demo HKD; ~7.8 would convert the US names to true HKD). HK sources
# (sina/tencent) are already HKD and always use 1.0 — this global does NOT affect GLM.
FX_QUOTE_PER_USD=1.0
# Enable the secondary source per asset (US: Yahoo; HK: Tencent). 1 = on.
PRICE_FEED_FALLBACK=1
# Endpoint overrides (mainly for testing).
NASDAQ_API_BASE=https://api.nasdaq.com/api/quote
YAHOO_API_BASE=https://query1.finance.yahoo.com
NEBIUS_API_BASE=https://api.nebius.cloud/billing/v1alpha1/spot-price
SINA_API_BASE=https://hq.sinajs.cn
TENCENT_API_BASE=https://qt.gtimg.cn
# Implausible absolute jump vs the last value (basis points) — WARNING only, value still used.
PRICE_MAX_JUMP_BPS=5000
# Reject absurd prices above this many units (sanity band; default 1e9).
PRICE_SANITY_MAX=1000000000

# ---------- Logging ----------
LOG_LEVEL=INFO
