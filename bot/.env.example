# IRMarket Bot — Environment Configuration

# Private key of the verifier wallet (must hold MON + approved tokens)
PRIVATE_KEY=0x_your_private_key_here

# Monad WebSocket RPC (testnet) — for sending txs
RPC_WS_URL=wss://testnet-rpc.monad.xyz/ws

# Monad HTTP RPC (testnet) — for polling event logs
RPC_HTTP_URL=https://rpc-testnet.monadinfra.com

# IRMarket contract address
MARKET_ADDRESS=0x...

# Monoracle settlement contract (live on Monad testnet)
ORACLE_ADDRESS=0x1ABABc60Ca6950C94eA80F2f611AB06aAAAD28c0

# ---------- Monitored Pairs & Fair Prices ----------
# Single-pair fallback (used only when ASSETS_FILE has no usable assets).
# Format: BASE_TOKEN,QUOTE_TOKEN,FAIR_PRICE
# Fair price is 1e18 fixed-point
MONITORED_PAIRS=0xAf078b1cAb4797bA018C8354913eaE22f0f1F719,0x3c34C844EeaeCbc760a74723FC67d8DF49a05093,130000000000000000000

# Optional display symbol for the single-pair fallback (defaults to base token prefix)
# ASSET_SYMBOL=NVDA

# ---------- Multi-Asset (optional) ----------
# Path to a deployment-assets.json written by the deploy script. Relative paths
# resolve against the repo root; defaults to deployment-assets.json there.
# When the file exists and lists at least one asset, the bot runs ONE PAIR PER
# ASSET and MONITORED_PAIRS/MARKET_ID below are ignored. Schema:
#   {
#     "network": "monad-testnet", "chainId": 10143,
#     "oracle": "0x...", "market": "0x...", "quoteToken": "0x...",
#     "assets": [
#       { "symbol": "NVDA", "baseToken": "0x...", "quoteToken": "0x...",
#         "fairPrice": "130000000000000000000", "marketId": "2", "expiryBlock": "12345" }
#     ]
#   }
# `oracle`/`market`/`quoteToken` are shared; each asset supplies its own
# `baseToken`, `fairPrice` (1e18 string) and `marketId`.
# ASSETS_FILE=deployment-assets.json

# ---------- Round Model (docs/plan/one-market-per-pair-plan.md) ----------
# The IRMarket marketId the bot serves (trade target for the web; advisory for the bot).
MARKET_ID=0
# Round length in blocks (3000 = 15 min @300ms). A round = a Monoracle quote
# expiryBlock; the bot settles expired rounds and starts the next at block+ROUND_BLOCKS.
# It NEVER calls createMarket in the loop — one market per pair, created by
# script/deploy-market-stack.js.
ROUND_BLOCKS=3000
# OPTIONAL one-shot ensure, default OFF: create the pair's single market ONLY if the
# configured marketId is missing on the wrapper (self-heal). Never per-round.
AUTO_CREATE_MARKET=0
# Wrapper fee basis points for a market the bot (rarely) ensures (1% = 100)
FEE_BPS=100

# ---------- Veto Threshold ----------
# Minimum deviation in basis points (1 bp = 0.01%) to trigger a veto
THRESHOLD_BPS=100

# ---------- Startup Catch-Up ----------
CATCH_UP_BLOCKS=10

# ---------- Gas Configuration ----------
# Monad charges by gas LIMIT, not gasUsed, so these limits ARE the cost of every
# send. The defaults in bot/verifier.py are measured (see the GAS_DEFAULTS table
# there); override one only to bump it, never to guess. Re-measure with
# `npx hardhat run script/gas-report.js` before changing the defaults.
# GAS_APPROVE_WEI=60000
# GAS_SUBMIT_QUOTE_WEI=340000
# GAS_SETTLE_WEI=100000
# GAS_WITHDRAW_WEI=120000
# GAS_CREATE_MARKET_WEI=300000
#
# Optional ceiling on gasPrice (wei). The bot otherwise uses eth_gas_price.
# GAS_PRICE_CAP_WEI=200000000000

# ---------- Quoting Loop (D-05) ----------
# Loop cadence (seconds). Quotes are restocked on veto; this is the poll rate.
QUOTE_INTERVAL_SECONDS=5
# Quote collateral size (base units, 1e18 decimals)
QUOTE_BASE_AMOUNT=1000000000000000000

# ---------- Expiry Settlement Quote (D-06) ----------
# Lead blocks before expiry at which the final settlement quote is submitted
# (it settles LAST and becomes the round mark)
SETTLEMENT_QUOTE_LEAD_BLOCKS=2

# ---------- Logging ----------
LOG_LEVEL=INFO