# Copy this file to .env and fill in your values
# .env is gitignored — never commit real secrets

# Monad testnet deployer wallet private key (0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC endpoint (default: Monad testnet)
# RPC_URL=https://testnet-rpc.monad.xyz

# Chain ID (default: 10143 = Monad testnet)
# CHAIN_ID=10143

# Deployed contract addresses (filled after deployment)
# OPTION_MARKET_ADDRESS=0x...
# ORACLE_ADDRESS=0x...   <- MonoracleWindowed (IRMarket-deployed fork with per-quote
#                            expiryBlock window, PRD D-13). NOT the upstream Monoracle
#                            testnet deployment (fixed 2-slot window).

# Monoracle settlement contract (upstream, live on Monad testnet — informational only;
# IRMarket trades on its own MonoracleWindowed instance):
#   0x1ABABc60Ca6950C94eA80F2f611AB06aAAAD28c0

# Monoracle demo test tokens on Monad testnet (used by the monoracle bot/frontend)
# IRMarket demo tokens (LLM/HKD) are minted by script/deploy-tokens.js — pin them here
# after running it:
BASE_TOKEN=0x...
QUOTE_TOKEN=0x...
# Upstream monoracle testnet tokens (informational only):
#   BASE  0xAf078b1cAb4797bA018C8354913eaE22f0f1F719
#   QUOTE 0x3c34C844EeaeCbc760a74723FC67d8DF49a05093