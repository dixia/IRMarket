# Copy this file to .env and fill in your values
# .env is gitignored — never commit real secrets

# Monad testnet deployer wallet private key (0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC endpoint (default: Monad testnet)
# RPC_URL=https://testnet-rpc.monad.xyz

# Chain ID (default: 10143 = Monad testnet)
# CHAIN_ID=10143

# Deployed contract addresses (filled after deployment)
# OPTION_MARKET_ADDRESS=0x...

# Monoracle settlement contract (live on Monad testnet, deployed by the
# reference monoracle project — the veto-arbitrage primitive IRMarket builds on)
ORACLE_ADDRESS=0x1ABABc60Ca6950C94eA80F2f611AB06aAAAD28c0

# Monoracle demo test tokens on Monad testnet (used by the monoracle bot/frontend)
BASE_TOKEN=0xAf078b1cAb4797bA018C8354913eaE22f0f1F719
QUOTE_TOKEN=0x3c34C844EeaeCbc760a74723FC67d8DF49a05093